# Database (Akamai/Linode Managed PostgreSQL)
# Connection details for your PostgreSQL database instance.
# DB_SSL should be "require" for managed/hosted databases.
DB_HOST=lin-12345-67890.servers.linodedb.net
DB_PORT=16409
DB_NAME=linodedb
DB_USER=linroot
DB_PASSWORD=your-db-password-here
DB_SSL=require

# JWT Auth
# JWT_SECRET should be a long, random string used to sign authentication tokens.
# JWT_EXPIRE_MINUTES controls how long a user session remains valid (480 = 8 hours).
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Linode API
# LINODE_API_BASE is the base URL for the Linode/Akamai Cloud API (no trailing slash).
# REFRESH_API_SECRET protects the GET /api/refresh endpoint used by external schedulers
# or cron jobs. Callers must pass this value as a Bearer token in the Authorization header:
#   Authorization: Bearer <secret>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LINODE_API_BASE=https://api.linode.com/v4
REFRESH_API_SECRET=your-refresh-secret-here

# CORS (comma-separated origins)
# List of frontend origins allowed to make cross-origin requests to the API.
# Example for multiple origins: http://localhost:5173,https://app.example.com
CORS_ORIGINS=http://localhost:5173

# Token Encryption
# TOKEN_ENCRYPTION_KEY is required. Linode API tokens are encrypted at rest using this key.
# REQUIRED — the server will refuse to start if this is not set.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# Registration Guard
# ALLOW_REGISTRATION controls whether the public /api/auth/register endpoint is enabled.
# Set to true ONLY when you need to create the very first admin account, then disable it.
# Default: false (registration is always closed unless explicitly enabled).
ALLOW_REGISTRATION=false

# Reverse Proxy Trust
# TRUSTED_PROXY_COUNT tells the rate limiter how many reverse proxy hops to trust when
# reading the client IP from X-Forwarded-For. Set to 1 if you have a single load balancer
# in front of the API. Leave at 0 (default) if the API is directly exposed — this disables
# X-Forwarded-For entirely and uses the direct connection IP.
TRUSTED_PROXY_COUNT=0
